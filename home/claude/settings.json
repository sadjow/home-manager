{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.04,
  "skillListingMaxDescChars": 300,
  "skillOverrides": {
    "agent-skill-content-research": "name-only",
    "artifact-capabilities": "name-only",
    "artifact-diagramming": "name-only",
    "browser-harness": "name-only",
    "clojure-development": "name-only",
    "fewer-permission-prompts": "name-only",
    "find-skills": "name-only",
    "flutter-adding-home-screen-widgets": "name-only",
    "flutter-animating-apps": "name-only",
    "flutter-architecting-apps": "name-only",
    "flutter-building-forms": "name-only",
    "flutter-building-layouts": "name-only",
    "flutter-building-plugins": "name-only",
    "flutter-caching-data": "name-only",
    "flutter-embedding-native-views": "name-only",
    "flutter-handling-concurrency": "name-only",
    "flutter-handling-http-and-json": "name-only",
    "flutter-implementing-navigation-and-routing": "name-only",
    "flutter-improving-accessibility": "name-only",
    "flutter-interoperating-with-native-apis": "name-only",
    "flutter-localizing-apps": "name-only",
    "flutter-managing-state": "name-only",
    "flutter-reducing-app-size": "name-only",
    "flutter-setting-up-on-linux": "name-only",
    "flutter-setting-up-on-macos": "name-only",
    "flutter-setting-up-on-windows": "name-only",
    "flutter-testing-apps": "name-only",
    "flutter-text-scaling-accessibility": "name-only",
    "flutter-theming-apps": "name-only",
    "flutter-working-with-databases": "name-only",
    "github-media-attachments": "name-only",
    "github-team-delivery-review": "name-only",
    "keybindings-help": "name-only",
    "schedule": "name-only",
    "skill-creator": "name-only",
    "update-config": "name-only",
    "workflow-authoring": "name-only"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_STREAM_FIRST_BYTE_TIMEOUT_MS": "30000",
    "API_TIMEOUT_MS": "120000"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:hexdocs.pm)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:ruby-doc.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:vuejs.org)",
      "WebFetch(domain:nixos.wiki)",
      "WebFetch(domain:clojuredocs.org)",
      "WebFetch(domain:clojure.org)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:rspec.rubystyle.guide)",
      "WebFetch(domain:lostisland.github.io)",
      "WebFetch(domain:mattbrictson.com)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git ls-tree:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(CLAUDE_PROJECT_DIR=/Users/sadjow npx tsx:*)",
      "Bash(git -C /Users/sadjow/.claude status:*)",
      "Bash(pgrep:*)",
      "Bash(mdfind:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sadjow/.claude/hooks/auto-format.sh"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "voiceEnabled": true
}
